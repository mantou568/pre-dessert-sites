  "requests": {
    "search": {
      "list": {
        "selector": "table.torrent_list tr:has(td.t_name)"
      },
      "fields": {
        "description": {
          "selector": "td.t_name h4"
        },
        "download": {
          "selector": "a[href*=\"download.php?hash=\"]",
          "attribute": "href"
        },
        "size": {
          "selector": "td.t_size",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "seeders": {
          "selector": "td.t_torrents"
        },
        "leechers": {
          "selector": "td.t_leech"
        },
        "grabs": {
          "selector": "td.t_completed"
        },
        "date_added": {
          "selector": "td.t_time span",
          "attribute": "title",
          "filters": [
            {
              "name": "timestamp"
            }
          ]
        },
        "labels": {
          "selector": "td.t_name span[title]",
          "array": true
        },
        "cover": {
          "any": [
            {
              "selector": "td.t_name img[data-src]",
              "attribute": "data-src"
            },
            {
              "selector": "td.t_name img[data-original]",
              "attribute": "data-original"
            },
            {
              "selector": "img[data-src*=\"imdb/images/\"],img[data-src*=\"poster\"]",
              "attribute": "data-src"
            },
            {
              "selector": "img[src*=\"imdb/images/\"],img[src*=\"poster\"],.poster img,.poster_box img",
              "attribute": "src"
            }
          ]
        }
      },
      "parser": "CssSelector",
      "method": "GET",
      "path": "/torrents.php",
      "params": {
        "search": [
          "{keyword}"
        ],
        "ms_compat": [
          "20261108-cover-rule"
        ]
      }
    },
    "seeding_statistics": {
      "disabled": true,
      "parser": "JsonPath",
      "method": "POST",
      "path": "/ajax_getusertorrentlist.php",
      "disabled_extends": {
        "list": true,
        "fields": true,
        "params": true,
        "headers": true
      },
      "form_data": {
        "userid": [
          "{userId}"
        ],
        "type": [
          "seeding"
        ]
      },
      "fields": {}
    },
    "sign_in": {
      "disabled": true,
      "parser": "JsonPath",
      "method": "POST",
      "path": "/plugin_sign-in.php?cmd=signin",
      "disabled_extends": {
        "fields": true,
        "params": true,
        "success_status_codes": true
      },
      "fields": {
        "signed_in": {
          "selector": "state",
          "filters": [
            {
              "name": "eq",
              "args": "success"
            }
          ]
        }
      }
    },
    "messages": {
      "list": {
        "selector": "//tr[td/a[contains(@href,\"action=viewmessage\")]]"
      },
      "fields": {
        "date": {
          "selector": "td[4]/span/@title"
        }
      }
    },
    "message_detail": {
      "fields": {
        "date": {
          "selector": "//h1/following-sibling::table//tr[2]/td[2]/span/@title"
        },
        "content": {
          "selector": "//td[@class=\"message_body\"]"
        }
      }
    },
    "notice": {
      "fields": {
        "title": {
          "selector": "//div[@class=\"announce\"]/h4[1]"
        },
        "content": {
          "selector": "//div[@class=\"announce\"]"
        },
        "date": {
          "selector": "//div[@class=\"announce\"]/h4[1]",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(\\d{4}\\.\\d{2}\\.\\d{2})",
                1
              ]
            }
          ]
        }
      }
    }
  }
}
