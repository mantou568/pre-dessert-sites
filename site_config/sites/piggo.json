{
  "id": "piggo",
  "name": "猪猪",
  "domain": "https://piggo.me",
  "api": "https://piggo.me",
  "public": false,
  "schema": "NexusPHP",
  "reuse_schema": "NexusPHP",
  "required": {
    "cookie": false,
    "sign_in": false
  },
  "meta": {
    "has_free": true,
    "has_2x_free": true,
    "has_hr": true,
    "has_cover": true
  },
  "category": {
    "movie": [
      {
        "id": 401,
        "cat": "Movies",
        "desc": "电影"
      }
    ],
    "tv": [
      {
        "id": 402,
        "cat": "TV/Series",
        "desc": "电视剧"
      },
      {
        "id": 403,
        "cat": "TV/Shows",
        "desc": "综艺"
      },
      {
        "id": 404,
        "cat": "TV/Documentaries",
        "desc": "纪录片"
      },
      {
        "id": 405,
        "cat": "TV/Animations",
        "desc": "动漫"
      },
      {
        "id": 908,
        "cat": "TV/Series",
        "desc": "儿童剧集"
      },
      {
        "id": 909,
        "cat": "Movies",
        "desc": "儿童电影"
      }
    ]
  },
  "requests": {
    "get_subtitle_url": {
      "disabled": true
    },
    "user_basic_info": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/profile",
      "fields": {
        "is_login": {
          "selector": "success",
          "filters": [
            {
              "name": "eq",
              "args": "true"
            }
          ]
        },
        "id": {
          "selector": "data.id"
        },
        "name": {
          "selector": "data.username"
        },
        "uploaded": {
          "selector": "data.uploaded"
        },
        "downloaded": {
          "selector": "data.downloaded"
        },
        "ratio": {
          "selector": "data.share_ratio"
        },
        "bonus": {
          "selector": "data.seedbonus"
        },
        "seeding_count": {
          "selector": "data.seeding_count"
        },
        "signed_in": {
          "selector": "data.signed_in_today",
          "filters": [
            {
              "name": "eq",
              "args": "true"
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/profile",
      "fields": {
        "level": {
          "selector": "data.class_name"
        },
        "join_at": {
          "selector": "data.added",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        },
        "last_accessed": {
          "selector": "data.last_access",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        },
        "seeding_count": {
          "selector": "data.seeding_count"
        }
      }
    },
    "seeding_statistics": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/profile",
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "count": {
          "selector": "data.seeding_count"
        },
        "size": {
          "selector": "data.seeding_size"
        },
        "seeding_count": {
          "selector": "data.seeding_count"
        },
        "seeding_size": {
          "selector": "data.seeding_size"
        }
      }
    },
    "seeding_size": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/profile",
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "size": {
          "selector": "data.seeding_size"
        }
      }
    },
    "seeding_count": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/profile",
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "count": {
          "selector": "data.seeding_count"
        }
      }
    },
    "search": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/torrents",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "params": {
        "keyword": [
          "{keyword}"
        ],
        "per_page": [
          "100"
        ]
      },
      "list": {
        "selector": "data.items"
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "category": {
          "selector": "category_id"
        },
        "title": {
          "selector": "name"
        },
        "description": {
          "selector": "small_descr"
        },
        "details": {
          "selector": "detail_url"
        },
        "download": {
          "selector": "download_url"
        },
        "size": {
          "selector": "size"
        },
        "grabs": {
          "selector": "times_completed"
        },
        "seeders": {
          "selector": "seeders"
        },
        "leechers": {
          "selector": "leechers"
        },
        "date_added": {
          "selector": "added_ts"
        },
        "downloadvolumefactor": {
          "selector": "download_volume_factor"
        },
        "uploadvolumefactor": {
          "selector": "upload_volume_factor"
        },
        "labels": {
          "array": true,
          "selector": "tags"
        },
        "cover": {
          "selector": "poster_url"
        }
      }
    }
  }
}
