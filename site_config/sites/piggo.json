{
  "id": "piggo",
  "name": "猪猪",
  "domain": "https://piggo.me",
  "api": "https://api.piggo.me",
  "public": false,
  "schema": "NexusPHP",
  "reuse_schema": "NexusPHP",
  "required": {
    "cookie": false,
    "sign_in": false
  },
  "meta": {
    "has_free": false,
    "has_2x_free": false,
    "has_hr": false,
    "has_cover": true
  },
  "category": {},
  "requests": {
    "get_subtitle_url": {
      "disabled": true
    },
    "sign_in": {
      "disabled": true
    },
    "messages": {
      "disabled": true
    },
    "message_detail": {
      "disabled": true
    },
    "notice": {
      "disabled": true
    },
    "my_hr": {
      "disabled": true
    },
    "seeding_statistics": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/me/torrents",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {
        "kind": "seeding",
        "page": "{page}",
        "per_page": 100
      },
      "success_status_codes": [
        200
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "size": {
          "selector": "size"
        }
      },
      "list": {
        "selector": "data.items",
        "next_page": {
          "selector": "data.items.99.id",
          "filters": [
            {
              "name": "not_blank",
              "args": [
                "/v1/api/me/torrents",
                ""
              ]
            }
          ]
        }
      }
    },
    "user_basic_info": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/me",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {},
      "success_status_codes": [
        200
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "is_login": {
          "selector": "data.user.id",
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        },
        "id": {
          "selector": "data.user.id"
        },
        "name": {
          "selector": "data.user.username"
        },
        "uploaded": {
          "selector": "data.user.stats.uploaded",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "data.user.stats.downloaded",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "bonus": {
          "selector": "data.user.stats.bonus"
        }
      }
    },
    "user_details": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/me",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {},
      "success_status_codes": [
        200
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "level": {
          "selector": "data.user.class.name"
        },
        "join_at": {
          "selector": "data.user.created_at",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        },
        "last_accessed": {
          "selector": "data.user.last_access",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}",
                0
              ]
            },
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        }
      }
    },
    "search": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/torrents",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {
        "q": "{keyword}",
        "page": 1,
        "per_page": 50
      },
      "success_status_codes": [
        200
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "category": {
          "selector": "section_id"
        },
        "title": {
          "selector": "name"
        },
        "description": {
          "selector": "small_descr"
        },
        "details": {
          "selector": "page_url"
        },
        "size": {
          "selector": "size"
        },
        "grabs": {
          "selector": "times_completed"
        },
        "seeders": {
          "selector": "seeders"
        },
        "leechers": {
          "selector": "leechers"
        },
        "cover": {
          "selector": "cover"
        },
        "imdbid": {
          "selector": "media.imdb"
        },
        "date_added": {
          "selector": "added_at",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        }
      },
      "list": {
        "selector": "data.items"
      }
    },
    "details": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/torrents/{id}",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {},
      "success_status_codes": [
        200
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "peer_count": {
          "selector": "data.seeders"
        }
      }
    }
  }
}
