{
  "id": "piggo",
  "name": "猪猪",
  "domain": "https://piggo.me",
  "api": "https://api.piggo.me",
  "public": false,
  "schema": "NexusPHP",
  "reuse_schema": "NexusPHP",
  "required": {
    "cookie": false,
    "sign_in": false
  },
  "meta": {
    "has_free": false,
    "has_2x_free": false,
    "has_hr": false,
    "has_cover": true
  },
  "category": {},
  "requests": {
    "get_subtitle_url": {
      "disabled": true
    },
    "sign_in": {
      "disabled": true
    },
    "messages": {
      "disabled": true
    },
    "message_detail": {
      "disabled": true
    },
    "notice": {
      "disabled": true
    },
    "my_hr": {
      "disabled": true
    },
    "seeding_statistics": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/me/torrents",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {
        "kind": "seeding",
        "page": "{page}",
        "per_page": 100
      },
      "success_status_codes": [
        200
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "size": {
          "selector": "size"
        }
      },
      "list": {
        "selector": "data.items",
        "next_page": {
          "selector": "data.items.99.id",
          "filters": [
            {
              "name": "not_blank",
              "args": [
                "/v1/api/me/torrents",
                ""
              ]
            }
          ]
        }
      }
    },
    "user_basic_info": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/me",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {},
      "success_status_codes": [
        200
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "is_login": {
          "selector": "data.user.id",
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        },
        "id": {
          "selector": "data.user.id"
        },
        "name": {
          "selector": "data.user.username"
        },
        "uploaded": {
          "selector": "data.user.stats.uploaded",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "data.user.stats.downloaded",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "bonus": {
          "selector": "data.user.stats.bonus"
        },
        "ratio": {
          "selector": "data.user.stats.ratio"
        }
      }
    },
    "user_details": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/me",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {},
      "success_status_codes": [
        200
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "level": {
          "selector": "data.user.class.name"
        },
        "join_at": {
          "selector": "data.user.created_at",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        },
        "last_accessed": {
          "selector": "data.user.last_access",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}",
                0
              ]
            },
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        }
      }
    },
    "search": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/torrents",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {
        "q": "{keyword}",
        "page": "{page}",
        "per_page": 50
      },
      "success_status_codes": [
        200
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "category": {
          "selector": "section_id"
        },
        "title": {
          "selector": "name"
        },
        "description": {
          "selector": "small_descr"
        },
        "details": {
          "selector": "page_url"
        },
        "size": {
          "selector": "size"
        },
        "grabs": {
          "selector": "times_completed"
        },
        "seeders": {
          "selector": "seeders"
        },
        "leechers": {
          "selector": "leechers"
        },
        "cover": {
          "selector": "cover"
        },
        "imdb_id": {
          "selector": "media.imdb"
        },
        "date_added": {
          "selector": "added_at",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        },
        "labels": {
          "selector": "tag_ids",
          "array": true,
          "filters": [
            {
              "name": "case",
              "args": {
                "21": "未审",
                "17": "零魔",
                "15": "独占",
                "18": "自购",
                "9": "合集",
                "11": "完结",
                "3": "国语",
                "4": "中字",
                "5": "HDR 10",
                "1": "官方",
                "2": "禁转",
                "6": "3D",
                "7": "Dolby Vision",
                "8": "特效",
                "10": "Dolby Atmos",
                "12": "追更",
                "13": "怀旧计划",
                "14": "应求",
                "16": "分集",
                "19": "中英双语",
                "20": "备胎",
                "22": "丐帮"
              }
            }
          ]
        },
        "douban_id": {
          "selector": "media.douban"
        }
      },
      "list": {
        "selector": "data.items"
      },
      "params": {
        "page": [
          "{page}"
        ]
      }
    },
    "details": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/torrents/{id}",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {},
      "success_status_codes": [
        200,
        404
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "absent": {
          "selector": "code",
          "filters": [
            {
              "name": "eq",
              "args": "404"
            }
          ]
        },
        "peer_count": {
          "selector": "data.seeders"
        }
      }
    },
    "download_link": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "path": "/v1/api/torrents/{id}/download-link",
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {},
      "success_status_codes": [
        200
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "required_headers": true,
        "params": true,
        "form_data": true,
        "body": true,
        "success_status_codes": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "url": {
          "selector": "data.url"
        }
      }
    }
  },
  "first_page_offset": 1
}
