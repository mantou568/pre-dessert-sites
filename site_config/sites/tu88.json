{
  "id": "tu88",
  "name": "tu88",
  "domain": "https://pt.tu88.men",
  "additional_domain": [
    "http://pt.tu88.men"
  ],
  "public": false,
  "schema": "attendance_captcha",
  "required": {
    "cookie": true,
    "sign_in": true
  },
  "meta": {
    "has_free": true,
    "has_2x_free": true,
    "has_hr": true,
    "has_cover": true
  },
  "category": {
    "movie": [
      {
        "id": 401,
        "cat": "Movies",
        "desc": "Movies/电影"
      },
      {
        "id": 407,
        "cat": "Movies/Sports",
        "desc": "Sports/体育"
      }
    ],
    "tv": [
      {
        "id": 404,
        "cat": "TV/Documentary",
        "desc": "Documentaries/纪录片"
      },
      {
        "id": 405,
        "cat": "TV/Anime",
        "desc": "Animations/动漫"
      },
      {
        "id": 402,
        "cat": "TV",
        "desc": "TV Series/连续剧"
      },
      {
        "id": 403,
        "cat": "TV",
        "desc": "TV Shows/综艺"
      },
      {
        "id": 440,
        "cat": "TV",
        "desc": "frame/短剧"
      }
    ]
  },
  "requests": {
    "message_detail": {
      "fields": {
        "content": {
          "selector": "//*[@id='outer']/font/b/table[2]/tbody/tr[3]/td"
        }
      }
    },
    "search": {
      "fields": {
        "hr_days": {
          "filters": [
            {
              "name": "constant",
              "args": "3"
            }
          ]
        }
      }
    },
    "sign_in_page": {
      "parser": "None",
      "method": "GET",
      "path": "/attendance.php",
      "disabled_extends": {
        "params": true
      }
    },
    "image": {
      "parser": "None",
      "disabled_extends": {
        "params": true
      }
    },
    "sign_in_action": {
      "parser": "None",
      "method": "POST",
      "path": "/attendance.php",
      "disabled_extends": {
        "params": true
      },
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      }
    }
  },
  "my_hr": {
    "path": "/myhr.php?status=1"
  },
  "reuse_schema": "NexusPHP"
}
