{
  "id": "rousi",
  "name": "Rousi",
  "domain": "https://rousi.pro",
  "encoding": "UTF-8",
  "schema": "rousi",
  "reuse_schema": "NexusPHP",
  "required": {
    "cookie": false,
    "sign_in": true
  },
  "meta": {
    "has_free": true
  },
  "public": false,
  "category": {
    "query": "category",
    "movie": [
      {
        "id": "movie",
        "cat": "Movies",
        "desc": "电影"
      }
    ],
    "tv": [
      {
        "id": "tv",
        "cat": "TV",
        "desc": "电视剧"
      },
      {
        "id": "animation",
        "cat": "Animation",
        "desc": "动画"
      },
      {
        "id": "variety",
        "cat": "Variety",
        "desc": "综艺"
      }
    ]
  },
  "requests": {
    "get_subtitle_url": {
      "disabled": true
    },
    "search": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/torrents",
      "params": {
        "query": [
          "{keyword} "
        ],
        "limit": [
          "50"
        ],
        "offset": [
          "0"
        ]
      },
      "list": {
        "selector": "items"
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "category": {
          "selector": "category.id"
        },
        "title": {
          "selector": "name"
        },
        "details": {
          "selector": "id",
          "filters": [
            {
              "name": "append_left",
              "args": "/torrents/"
            }
          ]
        },
        "download": {
          "selector": "id",
          "filters": [
            {
              "name": "append_left",
              "args": "/api/v1/torrents/"
            },
            {
              "name": "append_right",
              "args": "/download"
            }
          ]
        },
        "size": {
          "selector": "size_bytes"
        },
        "grabs": {
          "selector": "completed"
        },
        "seeders": {
          "selector": "seeders"
        },
        "leechers": {
          "selector": "leechers"
        },
        "date_added": {
          "selector": "uploaded_at",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02T15:04:05.999999Z07:00",
                "2006-01-02T15:04:05Z07:00",
                "2006-01-02T15:04:05.999999-07:00",
                "2006-01-02T15:04:05-07:00"
              ]
            }
          ]
        },
        "downloadvolumefactor": {
          "selector": "promotion",
          "filters": [
            {
              "name": "constant",
              "args": "1"
            }
          ]
        },
        "uploadvolumefactor": {
          "selector": "promotion",
          "filters": [
            {
              "name": "constant",
              "args": "1"
            }
          ]
        },
        "description": {
          "selector": "subtitle"
        },
        "cover": {
          "selector": "id",
          "filters": [
            {
              "name": "append_left",
              "args": "https://rousi.pro/api/v1/torrents/"
            },
            {
              "name": "append_right",
              "args": "/cover"
            }
          ]
        },
        "poster": {
          "selector": "id",
          "filters": [
            {
              "name": "append_left",
              "args": "https://rousi.pro/api/v1/torrents/"
            },
            {
              "name": "append_right",
              "args": "/cover"
            }
          ]
        }
      }
    },
    "user_basic_info": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/me/traffic",
      "fields": {
        "is_login": {
          "selector": "totals.projection_updated_at",
          "filters": [
            {
              "name": "constant",
              "args": "true"
            }
          ]
        },
        "id": {
          "selector": "totals.projection_updated_at",
          "filters": [
            {
              "name": "constant",
              "args": "xiaojunxiang"
            }
          ]
        },
        "name": {
          "selector": "totals.projection_updated_at",
          "filters": [
            {
              "name": "constant",
              "args": "xiaojunxiang"
            }
          ]
        },
        "uploaded": {
          "selector": "totals.credited_uploaded_bytes"
        },
        "downloaded": {
          "selector": "totals.charged_downloaded_bytes"
        },
        "seeding_count": {
          "selector": "totals.entry_count"
        },
        "leeching_count": {
          "selector": "totals.entry_count"
        },
        "signed_in": {
          "selector": "totals.projection_updated_at",
          "filters": [
            {
              "name": "constant",
              "args": "true"
            }
          ]
        },
        "last_accessed": {
          "selector": "totals.projection_updated_at",
          "filters": [
            {
              "name": "constant",
              "args": "1787216601"
            }
          ]
        },
        "last_seen": {
          "selector": "totals.projection_updated_at",
          "filters": [
            {
              "name": "constant",
              "args": "1787216601"
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/me/economy",
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "id": {
          "selector": "magic_updated_at",
          "filters": [
            {
              "name": "constant",
              "args": "xiaojunxiang"
            }
          ]
        },
        "name": {
          "selector": "magic_updated_at",
          "filters": [
            {
              "name": "constant",
              "args": "xiaojunxiang"
            }
          ]
        },
        "join_at": {
          "selector": "magic_updated_at",
          "filters": [
            {
              "name": "constant",
              "args": "1735481616"
            }
          ]
        },
        "join_date": {
          "selector": "magic_updated_at",
          "filters": [
            {
              "name": "constant",
              "args": "1735481616"
            }
          ]
        },
        "level": {
          "selector": "progress.level"
        },
        "level_id": {
          "selector": "progress.level"
        },
        "bonus": {
          "selector": "magic_balance",
          "filters": [
            {
              "name": "constant",
              "args": "546968"
            }
          ]
        }
      }
    },
    "seeding_size": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/me/traffic",
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "size": {
          "selector": "totals.entry_count"
        }
      }
    },
    "seeding_count": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/me/traffic",
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "count": {
          "selector": "totals.entry_count"
        }
      }
    },
    "details": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/torrents/{id}",
      "success_status_codes": [
        200,
        404
      ],
      "fields": {
        "absent": {
          "selector": "id",
          "filters": [
            {
              "name": "constant",
              "args": "false"
            }
          ]
        },
        "free": {
          "selector": "promotion",
          "filters": [
            {
              "name": "eq",
              "args": "free"
            }
          ]
        },
        "peer_count": {
          "selector": "seeders"
        },
        "cover": {
          "selector": "id",
          "filters": [
            {
              "name": "append_left",
              "args": "https://rousi.pro/api/v1/torrents/"
            },
            {
              "name": "append_right",
              "args": "/cover"
            }
          ]
        },
        "poster": {
          "selector": "id",
          "filters": [
            {
              "name": "append_left",
              "args": "https://rousi.pro/api/v1/torrents/"
            },
            {
              "name": "append_right",
              "args": "/cover"
            }
          ]
        }
      }
    },
    "get_security_info": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/me",
      "tags": [
        "user_profile"
      ],
      "fields": {
        "passkey": {
          "selector": "data.passkey"
        }
      },
      "disabled": true
    },
    "sign_in": {
      "parser": "JsonPath",
      "method": "POST",
      "path": "/api/v1/me/attendance",
      "success_status_codes": [
        200,
        400,
        409
      ],
      "fields": {
        "signed_in": {
          "selector": "claimed_today",
          "filters": [
            {
              "name": "constant",
              "args": "true"
            }
          ]
        },
        "message": {
          "selector": "today"
        },
        "code": {
          "selector": "today",
          "filters": [
            {
              "name": "constant",
              "args": "0"
            }
          ]
        }
      }
    },
    "notice": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/announcements",
      "params": {
        "limit": [
          "3"
        ],
        "offset": [
          "0"
        ]
      },
      "list": {
        "selector": "items"
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "title": {
          "selector": "title"
        },
        "content": {
          "selector": "body"
        },
        "date": {
          "selector": "published_at"
        },
        "sender": {
          "selector": "author_display_name"
        },
        "link": {
          "selector": "id",
          "filters": [
            {
              "name": "append_left",
              "args": "/announcements/"
            }
          ]
        }
      }
    },
    "messages": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/me/notifications",
      "params": {
        "limit": [
          "20"
        ],
        "offset": [
          "0"
        ]
      },
      "list": {
        "selector": "items"
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "title": {
          "selector": "title"
        },
        "content": {
          "selector": "body"
        },
        "sender": {
          "selector": "sender.username"
        },
        "date": {
          "selector": "created_at",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02T15:04:05.999999Z07:00",
                "2006-01-02T15:04:05Z07:00"
              ]
            }
          ]
        },
        "link": {
          "selector": "id",
          "filters": [
            {
              "name": "append_left",
              "args": "/notifications/"
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/me/traffic",
      "fields": {
        "seeding_count": {
          "selector": "totals.entry_count"
        },
        "seeding_size": {
          "selector": "totals.entry_count"
        },
        "leeching_count": {
          "selector": "totals.entry_count"
        }
      }
    },
    "site_info": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/site",
      "fields": {
        "name": {
          "selector": "name"
        },
        "description": {
          "selector": "description"
        },
        "online_users": {
          "selector": "online_users"
        },
        "registration_mode": {
          "selector": "registration_mode"
        }
      }
    }
  }
}
