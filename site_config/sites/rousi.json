{
 "id": "rousi",
 "name": "Rousi",
 "domain": "https://rousi.pro",
 "encoding": "UTF-8",
 "schema": "rousi",
 "reuse_schema": "NexusPHP",
 "required": {
  "cookie": true,
  "sign_in": true
 },
 "meta": {
  "has_free": true
 },
 "public": false,
 "category": {
  "query": "category",
  "movie": [
   {
    "id": "movie",
    "cat": "Movies",
    "desc": "电影"
   }
  ],
  "tv": [
   {
    "id": "tv",
    "cat": "TV",
    "desc": "电视剧"
   },
   {
    "id": "animation",
    "cat": "TV",
    "desc": "动画"
   },
   {
    "id": "variety",
    "cat": "Variety",
    "desc": "综艺"
   }
  ]
 },
 "requests": {
  "get_subtitle_url": {
   "disabled": true
  },
  "search": {
   "parser": "JsonPath",
   "method": "GET",
   "use_api": true,
   "required_headers": [
    "Authorization"
   ],
   "path": "/api/v1/torrents",
   "params": {
    "page": [
     "1"
    ],
    "page_size": [
     "100"
    ],
    "sort": [
     "created_at DESC"
    ],
    "keyword": [
     "{keyword}"
    ]
   },
   "list": {
    "selector": "data.torrents"
   },
   "fields": {
    "id": {
     "selector": "uuid"
    },
    "category": {
     "selector": "category"
    },
    "title": {
     "selector": "title"
    },
    "details": {
     "selector": "uuid",
     "filters": [
      {
       "name": "append_left",
       "args": "/torrents/"
      }
     ]
    },
    "download": {
     "selector": "uuid",
     "filters": [
      {
       "name": "append_left",
       "args": "/api/v1/torrents/"
      },
      {
       "name": "append_right",
       "args": "/download"
      }
     ]
    },
    "size": {
     "selector": "size"
    },
    "grabs": {
     "selector": "downloads"
    },
    "seeders": {
     "selector": "seeders"
    },
    "leechers": {
     "selector": "leechers"
    },
    "date_added": {
     "selector": "created_at",
     "filters": [
      {
       "name": "timestamp",
       "args": [
        "2006-01-02T15:04:05.999999-07:00",
        "2006-01-02T15:04:05-07:00",
        "2006-01-02T15:04:05.999Z"
       ]
      }
     ]
    },
    "downloadvolumefactor": {
     "selector": "promotion.down_multiplier"
    },
    "uploadvolumefactor": {
     "selector": "promotion.up_multiplier"
    },
    "description": {
     "selector": "subtitle"
    },
    "imdb_id": {
     "selector": "attributes.imdb_id"
    }
   }
  },
  "user_basic_info": {
   "parser": "JsonPath",
   "method": "GET",
   "use_api": true,
   "required_headers": [
    "Authorization"
   ],
   "path": "/api/v1/profile",
   "fields": {
    "is_login": {
     "selector": "code",
     "filters": [
      {
       "name": "eq",
       "args": "0"
      }
     ]
    },
    "id": {
     "selector": "data.username"
    },
    "name": {
     "selector": "data.username"
    },
    "uploaded": {
     "selector": "data.uploaded",
     "filters": [
      {
       "name": "byte_size"
      }
     ]
    },
    "downloaded": {
     "selector": "data.downloaded",
     "filters": [
      {
       "name": "byte_size"
      }
     ]
    },
    "bonus": {
     "selector": "data.karma"
    },
    "seeding_count": {
     "selector": "data.seeding_leeching_data.seeding_count"
    },
    "leeching_count": {
     "selector": "data.seeding_leeching_data.leeching_count"
    }
   }
  },
  "user_details": {
   "disabled": true
  },
  "seeding_size": {
   "parser": "JsonPath",
   "method": "GET",
   "use_api": true,
   "required_headers": [
    "Authorization"
   ],
   "path": "/api/v1/profile",
   "disabled_extends": {
    "headers": true,
    "list": true
   },
   "fields": {
    "size": {
     "selector": "data.seeding_leeching_data.seeding_size",
     "filters": [
      {
       "name": "byte_size"
      }
     ]
    }
   }
  },
  "seeding_count": {
   "parser": "JsonPath",
   "method": "GET",
   "use_api": true,
   "required_headers": [
    "Authorization"
   ],
   "path": "/api/v1/profile",
   "disabled_extends": {
    "headers": true,
    "list": true
   },
   "fields": {
    "count": {
     "selector": "data.seeding_leeching_data.seeding_count"
    }
   }
  },
  "details": {
   "parser": "JsonPath",
   "method": "GET",
   "use_api": true,
   "required_headers": [
    "Authorization"
   ],
   "path": "/api/v1/torrents/{id}",
   "success_status_codes": [
    200,
    404
   ],
   "fields": {
    "absent": {
     "selector": "code",
     "filters": [
      {
       "name": "eq",
       "args": "404"
      }
     ]
    },
    "free": {
     "selector": "data.promotion.down_multiplier",
     "filters": [
      {
       "name": "eq",
       "args": "0"
      }
     ]
    },
    "peer_count": {
     "selector": "data.leechers"
    }
   }
  },
  "get_security_info": {
   "disabled": true
  },
  "sign_in": {
   "parser": "JsonPath",
   "method": "POST",
   "use_api": true,
   "required_headers": [
    "Authorization"
   ],
   "path": "/api/points/attendance",
   "body": {
    "mode": "fixed"
   },
   "success_status_codes": [
    200,
    400
   ],
   "fields": {
    "signed_in": {
     "selector": "message",
     "filters": [
      {
       "name": "regex",
       "args": "(签到成功|今日已签到|已签到)"
      }
     ]
    },
    "message": {
     "selector": "message"
    },
    "code": {
     "selector": "code"
    }
   }
  },
  "notice": {
   "disabled": true
  },
  "messages": {
   "disabled": true
  },
  "seeding_statistics": {
   "parser": "JsonPath",
   "method": "GET",
   "use_api": true,
   "required_headers": [
    "Authorization"
   ],
   "path": "/api/v1/profile",
   "fields": {
    "seeding_count": {
     "selector": "data.seeding_leeching_data.seeding_count"
    },
    "seeding_size": {
     "selector": "data.seeding_leeching_data.seeding_size"
    },
    "leeching_count": {
     "selector": "data.seeding_leeching_data.leeching_count"
    }
   }
  }
 },
 "api": "https://rousi.pro"
}
