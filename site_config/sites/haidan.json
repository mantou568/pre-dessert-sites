{
  "id": "haidan",
  "name": "海胆之家",
  "domain": "https://www.haidan.cc",
  "encoding": "UTF-8",
  "public": false,
  "schema": "NexusPHP",
  "required": {
    "cookie": true,
    "sign_in": true
  },
  "meta": {
    "has_free": true,
    "has_cover": false
  },
  "category": {
    "movie": [
      {
        "id": 401,
        "cat": "Movies",
        "desc": "电影"
      },
      {
        "id": 406,
        "cat": "Movies",
        "desc": "Music Videos/音乐视频"
      },
      {
        "id": 407,
        "cat": "Movies/Sports",
        "desc": "Sports/体育"
      }
    ],
    "tv": [
      {
        "id": 402,
        "cat": "TV/Series",
        "desc": "电视剧"
      },
      {
        "id": 403,
        "cat": "TV/Shows",
        "desc": "综艺"
      },
      {
        "id": 404,
        "cat": "TV/Documentaries",
        "desc": "纪录片"
      },
      {
        "id": 405,
        "cat": "TV/Animations",
        "desc": "动漫"
      }
    ]
  },
  "requests": {
    "search": {
      "path": "/torrents.php",
      "list": {
        "selector": "div.torrent_panel_inner > div.torrent_group"
      },
      "fields": {
        "id": {
          "selector": "a[href*=\"details.php?group_id=\"]",
          "attribute": "href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "\\d+",
                0
              ]
            }
          ]
        },
        "title": {
          "selector": "a[href*=\"details.php?group_id=\"]"
        },
        "category": {
          "selector": "a[href*=\"?cat=\"]",
          "attribute": "title"
        },
        "details": {
          "selector": "a[href*=\"details.php?group_id=\"]",
          "attribute": "href"
        },
        "download": {
          "selector": "a[href*=\"download.php?id=\"]",
          "attribute": "href"
        },
        "size": {
          "selector": "div.torrent_group > div.group_content > div.group_detail_wrap > div.group_detail > div.torrent_detail > div:nth-child(1) > div.torrent_item > div.video_size",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "seeders": {
          "selector": "div.torrent_group > div.group_content > div.group > div.seeder_col"
        },
        "leechers": {
          "selector": "div.torrent_group > div.group_content > div.group > div.leecher_col"
        },
        "grabs": {
          "selector": "div.torrent_group > div.group_content > div.group > div.snatched_col"
        },
        "labels": {
          "selector": "div.torrent_group > div.group_content > div.group > div.table_cell > div.name > div.video_name_extra > div",
          "array": true
        },
        "date_added": {
          "selector": "div.torrent_group > div.group_content > div.group_detail_wrap > div.group_detail > div.torrent_detail > div:nth-child(1) > div.torrent_item > div.time_col > span[title]",
          "attribute": "title",
          "filters": [
            {
              "name": "timestamp"
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "XPath",
      "method": "GET",
      "path": "/getusertorrentlistajax.php?userid={userId}&type=seeding",
      "headers": {
        "Referer": "{domain}/userdetails.php?id={userId}"
      },
      "disabled_extends": {
        "headers": true
      },
      "fields": {
        "size": {
          "selector": "/td[3]",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        }
      },
      "list": {
        "selector": "//tr[position()>1]",
        "next_page": {
          "selector": "//a[contains(.//text(), '下一页') or contains(.//text(), '下一頁')]/@href"
        }
      }
    },
    "sign_in": {
      "parser": "XPath",
      "method": "GET",
      "path": "/signin.php",
      "success_status_codes": [
        200,
        302,
        403
      ],
      "fields": {
        "signed_in": {
          "selector": "//input[@id='modalBtn']/@value",
          "filters": [
            {
              "name": "regex",
              "args": "^(已经打卡|已打卡)$"
            }
          ]
        }
      }
    },
    "user_basic_info": {
      "parser": "XPath",
      "method": "GET",
      "path": "/",
      "fields": {
        "is_login": {
          "any": [
            {
              "selector": "//a[contains(@href, 'logout')]/text()"
            },
            {
              "selector": "//a[contains(@data-url, 'logout')]/text()"
            },
            {
              "selector": "//a[contains(@href, 'mybonus')]/text()"
            },
            {
              "selector": "//a[contains(@onclick, 'logout')]/text()"
            },
            {
              "selector": "//a[contains(@href, 'usercp')]/text()"
            },
            {
              "selector": "//form[contains(@action, 'logout')]/text()"
            },
            {
              "selector": "//div[@class='user-info-side']/text()"
            }
          ],
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        },
        "id": {
          "selector": "//a[contains(@href, \"userdetails.php?id=\")]/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "id=(\\d+)",
                1
              ]
            }
          ]
        },
        "name": {
          "selector": "//a[contains(@href, \"userdetails.php?id=\")]/b/text()"
        },
        "uploaded": {
          "selector": "//font[contains(@class,\"color_uploaded\")]/following-sibling::text()[1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "//font[contains(@class,\"color_downloaded\")]/following-sibling::text()[1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "ratio": {
          "selector": "//font[contains(@class,\"color_ratio\")]/following-sibling::text()[1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "Inf",
                "0"
              ]
            },
            {
              "name": "replace",
              "args": [
                "∞",
                "0"
              ]
            },
            {
              "name": "re_search",
              "args": [
                "([0-9.]+)",
                1
              ]
            }
          ]
        },
        "bonus": {
          "selector": "//*[@id=\"magic_num\"]/text()",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            },
            {
              "name": "re_search",
              "args": [
                "([0-9.]+)",
                1
              ]
            }
          ]
        },
        "signed_in": {
          "selector": "//input[@id='modalBtn']/@value",
          "filters": [
            {
              "name": "regex",
              "args": "^(已经打卡|已打卡)$"
            }
          ]
        }
      }
    }
  },
  "sign_in_required": {
    "interval_hour": "9-23"
  }
}
