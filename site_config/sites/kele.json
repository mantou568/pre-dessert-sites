{
  "id": "kele",
  "name": "可乐",
  "domain": "https://www.colapt.com",
  "encoding": "UTF-8",
  "public": false,
  "schema": "rousi",
  "required": {
    "cookie": false,
    "sign_in": false
  },
  "meta": {
    "has_free": true,
    "has_2x_free": false,
    "has_hr": false
  },
  "category": {
    "movie": [
      {
        "id": "movie",
        "cat": "Movies",
        "desc": "电影"
      }
    ],
    "tv": [
      {
        "id": "tv",
        "cat": "TV",
        "desc": "剧集"
      }
    ],
    "anime": [
      {
        "id": "anime",
        "cat": "Anime",
        "desc": "动漫"
      }
    ],
    "documentary": [
      {
        "id": "documentary",
        "cat": "Documentaries",
        "desc": "纪录片"
      }
    ],
    "variety": [
      {
        "id": "variety",
        "cat": "Variety",
        "desc": "综艺"
      }
    ]
  },
  "requests": {
    "user_basic_info": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/me/stats",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "is_login": {
          "selector": "user.username",
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        },
        "id": {
          "selector": "user.id"
        },
        "name": {
          "selector": "user.username"
        },
        "uploaded": {
          "selector": "raw_uploaded_bytes"
        },
        "downloaded": {
          "selector": "raw_downloaded_bytes"
        },
        "ratio": {
          "selector": "ratio"
        },
        "bonus": {
          "selector": "points_balance"
        }
      }
    },
    "user_details": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/me/stats",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "level": {
          "selector": "class_name"
        },
        "join_at": {
          "selector": "joined_at",
          "filters": [
            {
              "name": "timestamp"
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/me/stats",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "count": {
          "selector": "seeding"
        },
        "size": {
          "selector": "seeding_bytes"
        }
      }
    },
    "sign_in": {
      "disabled": true
    },
    "download_link": {
      "parser": "JsonPath",
      "method": "POST",
      "path": "/api/v1/torrents/{id}/download-links",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "url": {
          "selector": "download_url"
        }
      }
    },
    "details": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/torrents/{id}",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "success_status_codes": [
        200,
        404
      ],
      "fields": {
        "absent": {
          "selector": "error.code",
          "filters": [
            {
              "name": "eq",
              "args": "not_found"
            }
          ]
        },
        "free": {
          "selector": "promotion.download.num",
          "filters": [
            {
              "name": "eq",
              "args": "0"
            }
          ]
        },
        "2x_free": {
          "selector": "promotion.upload.num",
          "filters": [
            {
              "name": "eq",
              "args": "2"
            }
          ]
        },
        "peer_count": {
          "selector": "seeders"
        }
      }
    },
    "search": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/media",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "params": {
        "page": [
          "1"
        ],
        "q": [
          "{keyword}"
        ]
      },
      "disabled_extends": {
        "params": true,
        "fields": true,
        "field": true
      },
      "list": {
        "selector": "items"
      },
      "flat_map_fields": {
        "selector": "versions",
        "fields": {
          "id": {
            "selector": "id"
          },
          "title": {
            "selector": "release_name"
          },
          "size": {
            "selector": "size_bytes"
          },
          "seeders": {
            "selector": "seeders"
          },
          "leechers": {
            "selector": "leechers"
          },
          "grabs": {
            "selector": "completions"
          },
          "date_added": {
            "selector": "published_at",
            "filters": [
              {
                "name": "timestamp"
              }
            ]
          },
          "details": {
            "selector": "id",
            "filters": [
              {
                "name": "append_left",
                "args": "/torrents/"
              }
            ]
          },
          "downloadvolumefactor": {
            "selector": "promotion.download.num"
          },
          "uploadvolumefactor": {
            "selector": "promotion.upload.num"
          },
          "description": {
            "selector": "subtitle"
          }
        }
      },
      "fields": {
        "category": {
          "selector": "media.category"
        },
        "description": {
          "selector": "media.title"
        },
        "cover": {
          "selector": "media.poster_url"
        },
        "title": {
          "selector": "media.title"
        },
        "douban_id": {
          "selector": "media.douban_id"
        },
        "imdb_id": {
          "selector": "media.imdb_id"
        },
        "details": {
          "selector": "media.id",
          "filters": [
            {
              "name": "append_left",
              "args": "/media/"
            }
          ]
        }
      }
    },
    "notice": {
      "disabled": true
    },
    "messages": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/me/conversations",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "list": {
        "selector": "items"
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "title": {
          "selector": "title"
        },
        "content": {
          "selector": "last_message.excerpt"
        },
        "date": {
          "selector": "last_message_at",
          "filters": [
            {
              "name": "timestamp"
            }
          ]
        }
      },
      "disabled_extends": {
        "params": true
      },
      "params": {
        "page": [
          "1"
        ]
      }
    }
  },
  "first_page_offset": 1,
  "search_box": {
    "fields": []
  },
  "reuse_schema": null,
  "api": "https://www.colapt.com"
}