{
  "id": "sunny",
  "name": "Sunny",
  "domain": "https://sunnypt.top",
  "api": "https://api.sunnypt.top",
  "public": false,
  "schema": "NexusPHP",
  "required": {
    "cookie": true,
    "sign_in": true
  },
  "meta": {
    "has_free": true,
    "has_2x_free": true,
    "has_hr": false,
    "has_cover": true
  },
  "category": {
    "movie": [
      {
        "id": 401,
        "cat": "Movies",
        "desc": "Movies/电影"
      }
    ],
    "tv": [
      {
        "id": 404,
        "cat": "TV/Documentary",
        "desc": "Documentaries/纪录片"
      },
      {
        "id": 405,
        "cat": "TV/Anime",
        "desc": "Animations/动漫"
      },
      {
        "id": 402,
        "cat": "TV",
        "desc": "TV Series/连续剧"
      },
      {
        "id": 403,
        "cat": "TV",
        "desc": "TV Shows/综艺"
      }
    ]
  },
  "requests": {
    "favicon": {
      "parser": "None",
      "method": "GET",
      "path": "/favicon.ico"
    },
    "user_basic_info": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/user/details/info",
      "use_api": true,
      "required_headers": [
        "Authorization"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "is_login": {
          "selector": "code",
          "filters": [
            {
              "name": "eq",
              "args": "0"
            }
          ]
        },
        "id": {
          "selector": "data.id"
        },
        "name": {
          "selector": "data.username"
        },
        "uploaded": {
          "selector": "data.uploaded",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "data.downloaded",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "ratio": {
          "selector": "data.ratio"
        },
        "bonus": {
          "selector": "data.seed_bonus"
        },
        "seeding_count": {
          "selector": "data.upload_num"
        }
      }
    },
    "user_details": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/user/details/info",
      "use_api": true,
      "required_headers": [
        "Authorization"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "level_id": {
          "selector": "data.class"
        },
        "level": {
          "selector": "data.class",
          "filters": [
            {
              "name": "case",
              "args": {
                "0": "User",
                "1": "Power User",
                "2": "Elite User",
                "3": "Crazy User",
                "4": "Veteran User",
                "5": "Insane User",
                "6": "Extreme User",
                "7": "Ultimate User",
                "8": "Nexus Master"
              }
            }
          ]
        },
        "join_at": {
          "selector": "data.added"
        },
        "last_accessed": {
          "selector": "data.last_access"
        }
      }
    },
    "seeding_statistics": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/user/details/seeding?id={userId}&offset=0&limit=100",
      "use_api": true,
      "required_headers": [
        "Authorization"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "count": {
          "selector": "data.total"
        },
        "size": {
          "selector": "data.list[*].size",
          "array": true,
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        }
      }
    },
    "my_hr": {
      "disabled": true
    },
    "sign_in": {
      "parser": "JsonPath",
      "method": "POST",
      "path": "/api/v1/attendance/check-in",
      "use_api": true,
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "success_status_codes": [
        200
      ],
      "fields": {
        "signed_in": {
          "selector": "content",
          "filters": [
            {
              "name": "regex",
              "args": "(签到成功|今日已签到|已签到)"
            }
          ]
        },
        "message": {
          "selector": "msg"
        },
        "code": {
          "selector": "code"
        }
      }
    },
    "search": {
      "parser": "JsonPath",
      "method": "POST",
      "path": "/api/v1/torrent/list",
      "use_api": true,
      "required_headers": [
        "Authorization"
      ],
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "keyword": "{keyword}",
        "limit": 50,
        "offset": 0
      },
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "list": {
        "selector": "data.list"
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "category": {
          "selector": "category"
        },
        "title": {
          "selector": "name"
        },
        "description": {
          "selector": "sub_name"
        },
        "cover": {
          "selector": "cover"
        },
        "details": {
          "selector": "id",
          "filters": [
            {
              "name": "append_left",
              "args": "/torrent/"
            }
          ]
        },
        "download": {
          "selector": "id",
          "filters": [
            {
              "name": "append_left",
              "args": "/api/v1/torrent/download?id="
            }
          ]
        },
        "size": {
          "selector": "size"
        },
        "grabs": {
          "selector": "times_completed"
        },
        "seeders": {
          "selector": "seeders"
        },
        "leechers": {
          "selector": "leechers"
        },
        "date_added": {
          "selector": "added"
        },
        "downloadvolumefactor": {
          "selector": "promotion_type",
          "filters": [
            {
              "name": "case",
              "args": {
                "2": "0",
                "3": "0.5",
                "4": "0.3",
                "5": "0",
                "6": "0",
                "7": "0.5"
              }
            }
          ]
        },
        "uploadvolumefactor": {
          "filters": [
            {
              "name": "constant",
              "args": "1"
            }
          ]
        },
        "labels": {
          "selector": "tags",
          "array": true
        }
      }
    },
    "details": {
      "disabled": true
    },
    "get_subtitle_url": {
      "disabled": true
    }
  }
}
