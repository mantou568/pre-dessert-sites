{
  "id": "sunny",
  "name": "Sunny",
  "domain": "https://sunnypt.top",
  "api": "https://api.sunnypt.top",
  "public": false,
  "schema": "NexusPHP",
  "first_page_offset": 1,
  "required": {
    "cookie": false,
    "sign_in": false
  },
  "meta": {
    "has_free": true,
    "has_2x_free": true,
    "has_hr": false,
    "has_cover": false
  },
  "category": {
    "movie": [
      {
        "id": 401,
        "cat": "Movies",
        "desc": "电影"
      }
    ],
    "tv": [
      {
        "id": 402,
        "cat": "TV",
        "desc": "连续剧"
      },
      {
        "id": 403,
        "cat": "TV",
        "desc": "综艺"
      },
      {
        "id": 405,
        "cat": "TV/Anime",
        "desc": "动漫"
      },
      {
        "id": 404,
        "cat": "TV/Documentary",
        "desc": "纪录片"
      }
    ]
  },
  "requests": {
    "favicon": {
      "parser": "None",
      "method": "GET",
      "path": "/favicon.ico"
    },
    "user_basic_info": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/mp/profile",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "is_login": {
          "selector": "code",
          "filters": [
            {
              "name": "eq",
              "args": "0"
            }
          ]
        },
        "id": {
          "selector": "data.id"
        },
        "name": {
          "selector": "data.username"
        },
        "uploaded": {
          "selector": "data.uploaded"
        },
        "downloaded": {
          "selector": "data.downloaded"
        },
        "ratio": {
          "selector": "data.ratio"
        },
        "bonus": {
          "selector": "data.bonus"
        }
      }
    },
    "user_details": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/mp/profile",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "level_id": {
          "selector": "data.class"
        },
        "level": {
          "selector": "data.level"
        },
        "join_at": {
          "selector": "data.registered_at",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02T15:04:05Z07:00"
              ]
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/mp/profile",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "count": {
          "selector": "data.seeding_count"
        },
        "size": {
          "selector": "data.seeding_size"
        }
      }
    },
    "search": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/mp/torrents",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "params": {
        "page": [
          "{page}"
        ],
        "page_size": [
          "50"
        ],
        "keyword": [
          "{keyword}"
        ],
        "sort": [
          "created_at"
        ],
        "order": [
          "desc"
        ]
      },
      "list": {
        "selector": "data.items"
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "category": {
          "selector": "category.id"
        },
        "title": {
          "selector": "title"
        },
        "description": {
          "selector": "subtitle"
        },
        "details": {
          "selector": "details_url"
        },
        "size": {
          "selector": "size"
        },
        "grabs": {
          "selector": "completed"
        },
        "seeders": {
          "selector": "seeders"
        },
        "leechers": {
          "selector": "leechers"
        },
        "imdbid": {
          "selector": "imdb_id"
        },
        "date_added": {
          "selector": "created_at",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02T15:04:05Z07:00"
              ]
            }
          ]
        },
        "downloadvolumefactor": {
          "selector": "promotion.down_multiplier"
        },
        "uploadvolumefactor": {
          "selector": "promotion.up_multiplier"
        },
        "labels": {
          "selector": "tags",
          "array": true
        }
      }
    },
    "download_link": {
      "parser": "JsonPath",
      "method": "POST",
      "path": "/api/v1/mp/torrents/{id}/download-token",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "params": true,
        "list": true,
        "fields": true,
        "field": true
      },
      "fields": {
        "url": {
          "selector": "data.download_url",
          "filters": [
            {
              "name": "replace",
              "args": [
                "https://sunnypt.top/api/v1/mp/download/",
                "https://api.sunnypt.top/api/v1/mp/download/"
              ]
            }
          ]
        }
      }
    },
    "sign_in": {
      "disabled": true
    },
    "my_hr": {
      "disabled": true
    },
    "messages": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/notifications?limit=50&offset=0",
      "use_api": true,
      "required_headers": [
        "Authorization"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "list": true,
        "params": true
      },
      "list": {
        "selector": "data.list"
      },
      "fields": {
        "id": {
          "selector": "message_key"
        },
        "title": {
          "selector": "title"
        },
        "content": {
          "selector": "body"
        },
        "date": {
          "selector": "sent_at",
          "filters": [
            {
              "name": "timestamp"
            }
          ]
        }
      }
    },
    "message_detail": {
      "disabled": true
    },
    "notice": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/notifications?limit=20&offset=0",
      "use_api": true,
      "required_headers": [
        "Authorization"
      ],
      "disabled_extends": {
        "path": true,
        "headers": true,
        "list": true,
        "params": true
      },
      "fields": {
        "content": {
          "selector": "data.list.#(type==\"admin.broadcast\").body"
        }
      }
    },
    "details": {
      "disabled": true
    },
    "get_subtitle_url": {
      "disabled": true
    }
  }
}