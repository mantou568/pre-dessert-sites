{
  "id": "hd_area",
  "name": "好大",
  "domain": "https://hdarea.club",
  "api": "https://hdarea.club",
  "public": false,
  "schema": "NexusPHP",
  "reuse_schema": "NexusPHP",
  "required": {
    "cookie": false,
    "sign_in": true
  },
  "meta": {
    "has_free": true,
    "has_2x_free": true,
    "has_cover": true
  },
  "category": {
    "movie": [
      {
        "id": 300,
        "cat": "Movies/UHD",
        "desc": "Movies UHD-4K"
      },
      {
        "id": 401,
        "cat": "Movies/BluRay",
        "desc": "Movies Blu-ray"
      },
      {
        "id": 415,
        "cat": "Movies/HD",
        "desc": "Movies REMUX"
      },
      {
        "id": 416,
        "cat": "Movies/3D",
        "desc": "Movies 3D"
      },
      {
        "id": 410,
        "cat": "Movies/HD",
        "desc": "Movies 1080p"
      },
      {
        "id": 411,
        "cat": "Movies/HD",
        "desc": "Movies 720p"
      },
      {
        "id": 414,
        "cat": "Movies/DVD",
        "desc": "Movies DVD"
      },
      {
        "id": 412,
        "cat": "Movies/WEB-DL",
        "desc": "Movies WEB-DL"
      },
      {
        "id": 413,
        "cat": "Movies/HD",
        "desc": "Movies HDTV"
      },
      {
        "id": 417,
        "cat": "Movies/Other",
        "desc": "Movies iPad"
      }
    ],
    "tv": [
      {
        "id": 404,
        "cat": "TV/Documentary",
        "desc": "Documentaries"
      },
      {
        "id": 405,
        "cat": "TV/Anime",
        "desc": "Animations"
      },
      {
        "id": 402,
        "cat": "TV",
        "desc": "TV Series"
      },
      {
        "id": 403,
        "cat": "TV",
        "desc": "TV Shows"
      }
    ],
    "music": [
      {
        "id": 406,
        "cat": "Audio/Video",
        "desc": "Music Videos"
      },
      {
        "id": 408,
        "cat": "Audio",
        "desc": "HQ Audio"
      }
    ],
    "other": [
      {
        "id": 407,
        "cat": "Other",
        "desc": "Sports"
      },
      {
        "id": 409,
        "cat": "Other",
        "desc": "Misc"
      }
    ]
  },
  "requests": {
    "get_subtitle_url": {
      "disabled": true
    },
    "search": {
      "parser": "JsonPath",
      "method": "GET",
      "path": "/api/v1/torrents",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "params": {
        "keyword": [
          "{keyword}"
        ],
        "per_page": [
          "100"
        ]
      },
      "list": {
        "selector": "data.items"
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "category": {
          "selector": "category_id"
        },
        "title": {
          "selector": "name"
        },
        "description": {
          "selector": "small_descr"
        },
        "details": {
          "selector": "detail_url"
        },
        "download": {
          "selector": "download_url"
        },
        "size": {
          "selector": "size"
        },
        "grabs": {
          "selector": "times_completed"
        },
        "seeders": {
          "selector": "seeders"
        },
        "leechers": {
          "selector": "leechers"
        },
        "date_added": {
          "selector": "added_ts"
        },
        "downloadvolumefactor": {
          "selector": "download_volume_factor"
        },
        "uploadvolumefactor": {
          "selector": "upload_volume_factor"
        },
        "labels": {
          "array": true,
          "selector": "tags"
        },
        "cover": {
          "selector": "poster_url"
        },
        "imdb_id": {
          "selector": "imdb_id"
        },
        "douban_id": {
          "selector": "douban_id"
        }
      }
    },
    "user_basic_info": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/profile",
      "fields": {
        "is_login": {
          "selector": "success",
          "filters": [
            {
              "name": "eq",
              "args": "true"
            }
          ]
        },
        "id": {
          "selector": "data.id"
        },
        "name": {
          "selector": "data.username"
        },
        "uploaded": {
          "selector": "data.uploaded"
        },
        "downloaded": {
          "selector": "data.downloaded"
        },
        "ratio": {
          "selector": "data.share_ratio"
        },
        "bonus": {
          "selector": "data.seedbonus"
        },
        "seeding_count": {
          "selector": "data.seeding_count"
        },
        "signed_in": {
          "selector": "data.signed_in_today",
          "filters": [
            {
              "name": "eq",
              "args": "true"
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/profile",
      "fields": {
        "level": {
          "selector": "data.class_name"
        },
        "join_at": {
          "selector": "data.added",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        },
        "last_accessed": {
          "selector": "data.last_access",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        },
        "seeding_count": {
          "selector": "data.seeding_count"
        }
      }
    },
    "seeding_statistics": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/profile",
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "count": {
          "selector": "data.seeding_count"
        },
        "size": {
          "selector": "data.seeding_size"
        },
        "seeding_count": {
          "selector": "data.seeding_count"
        },
        "seeding_size": {
          "selector": "data.seeding_size"
        }
      }
    },
    "seeding_size": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/profile",
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "size": {
          "selector": "data.seeding_size"
        }
      }
    },
    "seeding_count": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/profile",
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "count": {
          "selector": "data.seeding_count"
        }
      }
    },
    "sign_in": {
      "parser": "JsonPath",
      "method": "POST",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/signin",
      "success_status_codes": [
        200
      ],
      "fields": {
        "signed_in": {
          "selector": "message",
          "filters": [
            {
              "name": "regex",
              "args": "(成功|已签到|今日已签到)"
            }
          ]
        },
        "message": {
          "selector": "message"
        }
      }
    },
    "messages": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/user/messages",
      "list": {
        "selector": "data.items"
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "title": {
          "selector": "subject"
        },
        "date": {
          "selector": "added",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        },
        "content": {
          "selector": "body"
        }
      }
    },
    "notice": {
      "parser": "JsonPath",
      "method": "GET",
      "use_api": true,
      "required_headers": [
        "X-API-Key"
      ],
      "path": "/api/v1/site/news",
      "list": {
        "selector": "data"
      },
      "fields": {
        "id": {
          "selector": "id"
        },
        "title": {
          "selector": "title"
        },
        "content": {
          "selector": "body"
        }
      }
    }
  }
}